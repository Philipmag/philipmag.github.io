# Copy to .env locally. Never commit your completed .env.
# All fields are server-side; never prefix a secret with VITE_.
PORT=3000
# Optional: without a key the app returns explicitly labelled local guidance.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional MySQL: only needed for calendar data and persisted training requests.
DATABASE_URL=

# Optional SMTP: required for sending the contact form.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=info@digitalguards.ca

# Reverse-proxy configuration, only when applicable.
# APP_ORIGIN=https://your-standalone-domain.example
# TRUST_PROXY=1
# DEV_ALLOWED_HOST=your-development-preview-host.example
